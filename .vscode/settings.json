{
  // Tailwind CSS v4 uses the @theme at-rule for CSS-first config.
  // The production build (vite + @tailwindcss/vite) already understands it —
  // this only quiets VS Code's built-in CSS validator ("Unknown at rule @theme").
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "less.lint.unknownAtRules": "ignore",

  // Let the Tailwind IntelliSense extension complete classes inside strings.
  "editor.quickSuggestions": {
    "strings": true
  },

  // Make sure the official Tailwind extension (not the old HTML/CSS one)
  // handles this workspace.
  "tailwindCSS.includeLanguages": {
    "javascript": "javascript",
    "javascriptreact": "javascript"
  }
}
